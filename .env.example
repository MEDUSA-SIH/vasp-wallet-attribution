# =============================================================================
# SIH26182 – VASP Wallet Attribution – environment template
# Copy this file to `.env` and adjust values for your local setup.
# NEVER commit a real `.env` file. Only `.env.example` is version controlled.
# =============================================================================

# ---- General -----------------------------------------------------------------
APP_NAME=sih26182-vasp-attribution
APP_VERSION=0.1.0
APP_ENV=local            # one of: local, dev, staging, prod
LOG_LEVEL=INFO
DEMO_MODE=true           # toggle synthetic offline mode (Phase 21/22)

# ---- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=*     # comma-separated list in production

# ---- Security ----------------------------------------------------------------
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=sih26182
POSTGRES_PASSWORD=sih26182
POSTGRES_DB=sih26182
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sih26182:sih26182@postgres:5432/sih26182
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---- Attribution engine -------------------------------------------------------
# Maximum number of hops to traverse during attribution (Phase 10 Stage B).
ATTRIBUTION_MAX_HOPS=5
# Hop budget per chain when fan-out is needed.
ATTRIBUTION_PER_CHAIN_BUDGET=3
# Confidence weights (sum should be 1.0) — placeholders for Phase 10 Stages E/F.
CONFIDENCE_WEIGHT_PROXIMITY=0.30
CONFIDENCE_WEIGHT_TYPOLOGY=0.20
CONFIDENCE_WEIGHT_TEMPORAL=0.15
CONFIDENCE_WEIGHT_BEHAVIORAL=0.20
CONFIDENCE_WEIGHT_CLUSTERING=0.15
# Minimum confidence threshold for a wallet to be presented in rankings.
CONFIDENCE_MIN_THRESHOLD=0.35

# ---- Provider toggles (Phase 20) ---------------------------------------------
PROVIDER_BITCOIN_ENABLED=false
PROVIDER_ETHEREUM_ENABLED=false
PROVIDER_TRON_ENABLED=false
PROVIDER_BNB_ENABLED=false
PROVIDER_SOLANA_ENABLED=false
PROVIDER_POLYGON_ENABLED=false
PROVIDER_DEMO_ENABLED=true

# External blockchain intelligence API keys (Phase 20, WP-04).
# ETH live path: set PROVIDER_ETHEREUM_ENABLED=true + BLOCKCHAIN_API_KEY (Etherscan).
# ETHEREUM_PROVIDER_URL defaults to Etherscan V2 multichain when empty.
BLOCKCHAIN_API_KEY=
ETHEREUM_PROVIDER_URL=
BITCOIN_PROVIDER_URL=
TRON_PROVIDER_URL=
BNB_PROVIDER_URL=
SOLANA_PROVIDER_URL=
POLYGON_PROVIDER_URL=

# ---- SAHYOG adapter (Phase 7) ------------------------------------------------
SAHYOG_BASE_URL=
SAHYOG_API_KEY=
SAHYOG_ENABLED=false

# ---- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Feature flags -----------------------------------------------------------
FEATURE_CROSS_CHAIN_BRIDGES=true
FEATURE_RISK_TYPOLOGIES=true
FEATURE_DEMO_DATA_SEED=false